<Window x:Class="Ordax.Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ORDAX Studio" Width="1680" Height="980" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="28"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#091522" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" Margin="0,0,12,0">
            <TextBlock Text="O" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#DDEEFF"/>
          </Border>
          <StackPanel>
            <TextBlock Text="ORDAX Studio" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Computer Control · projetos · MCP auditável" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </StackPanel>        <Border Grid.Column="2" Background="#0D2134" BorderBrush="#244C70" BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
          <TextBlock x:Name="TopConnectionState" Text="Conectando…" FontSize="11" Foreground="#BFD9F7"/>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="286"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#09131F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="COMPUTADOR" FontSize="10" FontWeight="SemiBold" Foreground="#6683A3" Margin="4,4,4,8"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Este computador" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="ComputerRailState" Text="Verificando capacidades…" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Conexão" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="RuntimeState" Text="Runtime: conectando…" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Projeto ativo" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProjectRailState" Text="Carregando projeto…" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <TextBlock Text="SEGURANÇA" FontSize="10" FontWeight="SemiBold" Foreground="#6683A3" Margin="4,10,4,8"/>
            <Border Background="#0B1925" BorderBrush="#29425D" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Acesso remoto com grants" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Ações do GPT passam pelo MCP e pelo Action Gateway. Nenhuma capability ganha autoridade só por existir."
                           Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" LineHeight="17"/>
              </StackPanel>
            </Border>

            <TextBlock Text="CAPACIDADES ESPECIALIZADAS" FontSize="10" FontWeight="SemiBold" Foreground="#6683A3" Margin="4,10,4,8"/>
            <Border Background="#0A151F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
              <StackPanel>
                <TextBlock Text="Blender · Unity" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Adapters do Studio — secundários ao Computer Control" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource BgBrush}">
        <TabControl x:Name="WorkTabs" SelectionChanged="WorkTabs_SelectionChanged" Margin="14,12,14,8">
          <TabItem Header="Visão geral">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}">              <StackPanel Margin="8,14,8,24">
                <Border Background="#10243A" BorderBrush="#28547D" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Controle do computador" FontSize="22" FontWeight="SemiBold"/>
                      <TextBlock Text="GPT + ORDAX Runtime, com ações tipadas e permissões auditáveis."
                                 FontSize="12" Foreground="#AFC6E0" Margin="0,6,0,0"/>
                      <TextBlock x:Name="ComputerControlState" Text="Verificando Computer Control…"
                                 FontSize="13" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#0C1B2A" BorderBrush="#2A5278" BorderThickness="1" CornerRadius="12" Padding="16,10" VerticalAlignment="Center">
                      <StackPanel>
                        <TextBlock Text="MCP" HorizontalAlignment="Center" Foreground="#7FA7D1" FontSize="10"/>
                        <TextBlock x:Name="ActionCountState" Text="—" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="ações do dispositivo" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>

                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>                  <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="Device Agent" FontWeight="SemiBold"/>
                      <TextBlock x:Name="DeviceCardState" Text="Verificando…" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="4,0">
                    <StackPanel>
                      <TextBlock Text="Remote MCP" FontWeight="SemiBold"/>
                      <TextBlock x:Name="McpCardState" Text="Verificando…" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                      <TextBlock Text="Projeto" FontWeight="SemiBold"/>
                      <TextBlock x:Name="ProjectCardState" Text="Carregando…" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <TextBlock Text="Capacidades do computador" FontSize="15" FontWeight="SemiBold" Margin="2,4,0,10"/>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>                  <Border Grid.Row="0" Grid.Column="0" Background="#0C1824" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,8">
                    <StackPanel>
                      <TextBlock Text="Tela e janelas" FontWeight="SemiBold"/>
                      <TextBlock Text="Screenshot · monitores · janela ativa · foco" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="0" Grid.Column="1" Background="#0C1824" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,8">
                    <StackPanel>
                      <TextBlock Text="Mouse e teclado" FontWeight="SemiBold"/>
                      <TextBlock Text="Click · scroll · mover · arrastar · digitar · hotkeys" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="0" Background="#0C1824" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,8,8,0">
                    <StackPanel>
                      <TextBlock Text="Arquivos e execução" FontWeight="SemiBold"/>
                      <TextBlock Text="Filesystem permitido · processos · terminal por grant" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="1" Background="#0C1824" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,8,0,0">
                    <StackPanel>
                      <TextBlock Text="Clipboard e aplicativos" FontWeight="SemiBold"/>
                      <TextBlock Text="Clipboard tipado · abrir apps · browser gerenciado" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <TextBlock Text="Atividade recente" FontSize="15" FontWeight="SemiBold" Margin="2,4,0,10"/>
                <TextBox x:Name="ActivityLog" MinHeight="150" MaxHeight="240" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas" FontSize="11"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>          <TabItem Header="Studio">
            <Border Background="#08111B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="1">
              <wv2:WebView2CompositionControl x:Name="StudioView" DefaultBackgroundColor="#080F19"/>
            </Border>
          </TabItem>

          <TabItem Header="Web IA">
            <Grid Background="#07101A">
              <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Background="#0B1724" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProviderSelector" Margin="4,5" SelectionChanged="ProviderSelector_SelectionChanged"/>
                <Button Grid.Column="1" Content="←" Click="ProviderBack_Click" ToolTip="Voltar"/>
                <Button Grid.Column="2" Content="→" Click="ProviderForward_Click" ToolTip="Avançar"/>
                <TextBox Grid.Column="3" x:Name="ProviderAddress" Margin="4,6" VerticalContentAlignment="Center" KeyDown="ProviderAddress_KeyDown"/>
                <Button Grid.Column="4" Content="↻" Click="ProviderRefresh_Click" ToolTip="Atualizar"/>
              </Grid>
              <wv2:WebView2CompositionControl x:Name="ProviderView" Grid.Row="1" DefaultBackgroundColor="#07101A"/>
            </Grid>
          </TabItem>

          <TabItem Header="Preview">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>              <Grid Grid.Row="0" Background="#0B1724" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="12,3,8,3" VerticalAlignment="Center">
                  <TextBlock x:Name="PreviewAddress" Text="Preview do projeto"/>
                  <TextBlock Text="Preview pertence ao projeto; Computer Control é independente." FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Iniciar" Click="StartPreview_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Grid.Column="2" Content="Capturar" Click="CapturePreview_Click"/>
                <Button Grid.Column="3" Content="Atualizar" Click="RefreshPreview_Click"/>
              </Grid>
              <wv2:WebView2CompositionControl x:Name="PreviewView" Grid.Row="1" DefaultBackgroundColor="#040A11"/>
            </Grid>
          </TabItem>

          <TabItem Header="Browser">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Background="#0B1724" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WorkbenchBrowserAddress" Margin="6" KeyDown="WorkbenchBrowserAddress_KeyDown"/>
                <Button Grid.Column="1" Content="Abrir" Click="WorkbenchBrowserGo_Click" Style="{StaticResource PrimaryButton}"/>
              </Grid>
              <wv2:WebView2CompositionControl x:Name="WorkbenchBrowserView" Grid.Row="1" DefaultBackgroundColor="#FFFFFF"/>
            </Grid>
          </TabItem>
          <TabItem Header="Execuções">
            <Grid Background="#07101A">
              <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Background="#0B1724" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="12,4" VerticalAlignment="Center">
                  <TextBlock Text="Runtime e automações" FontWeight="SemiBold"/>
                  <TextBlock Text="Processos persistentes e browsers gerenciados do projeto" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Atualizar" Click="RefreshExecutions_Click"/>
              </Grid>
              <TextBox Grid.Row="1" x:Name="ExecutionState" Margin="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas" FontSize="12"/>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#08121D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Pronto" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="Provider web ≠ automação · Computer Control passa por MCP + grants"
                   FontSize="10" Foreground="#60738C" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
