{
  "manifest_version": 3,
  "name": "ORDAX Browser Companion",
  "version": "0.1.0",
  "description": "Pairs ChatGPT Web conversations with ORDAX Dev on this computer.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8775/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:8775/bootstrap*"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ORDAX Browser Companion"
  }
}
